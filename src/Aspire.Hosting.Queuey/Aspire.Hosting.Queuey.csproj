<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Aspire.Hosting.Queuey</PackageId>
    <Title>Aspire.Hosting.Queuey</Title>
    <Description>Queuey in an Aspire AppHost: builder.AddQueuey("queuey", "1.0.0") runs a self-hosted Queuey on this machine from Queuey's pinned image, and WithReference(queuey) gives an app the addresses and a key for Queuey.Client. Starts nothing on restore, build or publish. Contains no Queuey server code.</Description>
    <PackageTags>aspire;integration;hosting;queuey;self-hosted;webhooks</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/Queuey-AI/queuey-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Queuey-AI/queuey-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Samme lisensfil som Queuey.Server.Hosting: én tekst for begge pakkene. -->
    <None Include="..\Queuey.Server.Hosting\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Queuey.Server.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queuey.Server.Hosting\Queuey.Server.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 13.6.5: 13.4.6 har GHSA-f7vh-h5g3-7jrh (macOS, High), og en offentlig pakke setter gulvet for AppHost-ene som bruker den. -->
    <PackageReference Include="Aspire.Hosting" Version="13.6.5" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
