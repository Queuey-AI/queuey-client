<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Queuey.Client.Cli\Queuey.Client.Cli.csproj" />
  </ItemGroup>

  <!-- En v2-spool bygd med v2-DDL, for migreringen gjennom edge status. Én kopi, eid av Edge-testene. -->
  <ItemGroup>
    <Compile Include="..\Queuey.Edge.Tests\TestSupport\V2SpoolFile.cs" Link="TestSupport\V2SpoolFile.cs" />
  </ItemGroup>

  <!-- Repoene advise leses mot (AdviseIntentTests): de bygges aldri, og koden deres hører ikke til testene. -->
  <ItemGroup>
    <Compile Remove="Fixtures/**" />
    <None Remove="Fixtures/**" />
  </ItemGroup>

</Project>
