# Copy to edge.env and fill it in. edge.env holds secrets: git ignores it, and
# it should be readable by you only (queuey keys mint --write makes it 0600).

# The workspace the gateway publishes to.
QUEUEY_TENANT=ten_...

# The queue's signing key. This writes both lines, and never prints the secret:
#   queuey keys mint --queue lighting-telemetry --tenant ten_... --write edge.env
QUEUEY_SIGNING_KEY_ID=
QUEUEY_SIGNING_SECRET=

# A publish-only key that only the health check-in uses (the check-in takes an
# API key today, not a signature). queuey keys mint --type api-key writes it as
# QUEUEY_API_KEY; rename that line to QUEUEY_EDGE_HEALTH_API_KEY.
QUEUEY_EDGE_HEALTH_API_KEY=

# Optional: a fixed node id, so the gateway stays the same node under Edge
# nodes even after `docker compose down -v` gives it a new spool. Up to 64 of
# A-Z a-z 0-9 . _ -, and unique to the machine (a serial number, say): two
# gateways with one id look like one node.
# QUEUEY_NODE_ID=lighting-gateway-1
